# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments ---
venv/
env/
.venv/
.env

# --- IDE Settings (VS Code / PyCharm) ---
.vscode/
.idea/
*.swp

# --- OS Generated Files ---
.DS_Store
Thumbs.db

# --- Big Data & ML Models (Too large for GitHub) ---
# Ignore the raw CSV data
data/*.csv
*.csv

# Ignore trained model files (Option 2: Don't upload models)
# If you ARE using Git LFS, remove the line below.
# *.pkl

# --- Flask ---
instance/
.webassets-cache

# --- Logs ---
*.log

# --- Generated Content ---
# Ignore the plots generated by Matplotlib
app/static/images/plots/
# (Optional) Keep the folder structure but ignore files inside
!app/static/images/plots/.gitkeep
